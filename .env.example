# smc-copilot-serve / Hermes Runtime Service 环境变量示例
# 复制为 copilot-serve/.env：  cp .env.example .env

# --- 遗留绑定（兼容保留；优先使用 RUNTIME_*）---
COPILOT_HOST=127.0.0.1
COPILOT_PORT=8765

# --- Runtime Service 绑定 ---
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8765

# 与 smc-copilot-desktop 用户数据目录一致（代码默认值相同；可不写本行）
SQLITE_PATH=~/.hermes/desktop/sqlite.db
#
# 仅本地调试且希望库在仓库内时，可改为：SQLITE_PATH=./data/sqlite.db
# Electron Main spawn 建议 cwd=copilot-serve 根目录，并注入本变量或绝对路径
# （例如 Windows：%USERPROFILE%\.hermes\desktop\sqlite.db）

HERMES_HOME=~/.hermes
LOG_DIR=./data/logs
DEFAULT_GATEWAY_PORT=8642
# GatewaySupervisor 调用的 Hermes Gateway CLI（默认：hermes gateway）
# 安装后优先使用 RuntimeVersion.executable_path；本项作为回退
HERMES_GATEWAY_COMMAND=hermes gateway
AIOS_TEAM_HUB_USE_STUB=true

# --- Runtime 服务态目录（空 = 平台默认；与程序安装目录分离）---
# Windows 服务态默认: %LOCALAPPDATA%\HermesRuntime（保持不变）
# macOS/Linux: ~/.hermes-runtime
RUNTIME_DATA_DIR=
RUNTIME_LOG_DIR=
RUNTIME_DOWNLOAD_DIR=
RUNTIME_STAGING_DIR=
RUNTIME_BACKUP_DIR=

HERMES_RUNTIME_CHANNEL=stable
HERMES_MANIFEST_URL=
HERMES_INSTALL_TIMEOUT_SECONDS=900
HERMES_DOCTOR_TIMEOUT_SECONDS=300
HERMES_GATEWAY_START_TIMEOUT_SECONDS=60
HERMES_GATEWAY_STOP_TIMEOUT_SECONDS=20

RUNTIME_REQUIRE_AUTH=false
RUNTIME_ALLOW_LEGACY_TOKEN=true
RUNTIME_LEGACY_TOKEN=
RUNTIME_MAX_OLD_VERSIONS=2
RUNTIME_JOB_LOG_RETENTION_DAYS=30
RUNTIME_GATEWAY_LOG_RETENTION_DAYS=14
# Windows：DPAPI 失败时默认拒绝；仅开发/测试可开 insecure XOR 文件存储
RUNTIME_ALLOW_INSECURE_SECRET_STORE=false

# --- 可配置工具链 ---
# Windows 企业约定：程序源码与 venv 必须在 D:\Programs 下
# Python/Node/Git 由工程师手工安装后再 clone 本仓库到 D:\Programs\copilot-serve
TOOLCHAIN_PYTHON_PATH=
TOOLCHAIN_NODE_PATH=
TOOLCHAIN_GIT_PATH=
# 空 = 使用 <HERMES_INSTALL_DIR>/<version>/venv
TOOLCHAIN_VENV_DIR=
# Windows 默认 D:\Programs\HermesAgent（代码内默认）；其它平台空则用 Runtime versions/
HERMES_INSTALL_DIR=D:\Programs\HermesAgent

# Desktop 鉴权（可选；v1.3 优先设备配对）
# COPILOT_DESKTOP_TOKEN=
# COPILOT_REQUIRE_TOKEN=false
# 逗号分隔；无端口项表示允许该 host 任意端口（含 electron-vite http://localhost:5173）
# CORS_ALLOW_ORIGINS=http://127.0.0.1,http://localhost,http://localhost:5173,http://127.0.0.1:5173
