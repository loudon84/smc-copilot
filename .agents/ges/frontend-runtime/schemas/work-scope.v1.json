{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smc.ges.work-scope.v1",
  "title": "GES Work Scope",
  "type": "object",
  "required": ["schema", "governance_tip", "target_apps", "token_budget"],
  "properties": {
    "schema": { "const": "smc.ges.work-scope.v1" },
    "repo": { "type": "string" },
    "governance_tip": { "enum": ["LEAN", "FULL"] },
    "governance_profile": { "enum": ["LEAN", "FULL"] },
    "target_apps": { "type": "array", "items": { "type": "string" } },
    "apps": { "type": "array" },
    "local_context": { "type": "object" },
    "token_budget": { "type": "object" }
  },
  "additionalProperties": true
}
