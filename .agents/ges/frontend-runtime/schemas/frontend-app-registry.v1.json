{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smc.ges.frontend-app-registry.v1",
  "title": "GES Frontend Application Registry",
  "type": "object",
  "required": ["schema", "apps"],
  "properties": {
    "schema": { "const": "smc.ges.frontend-app-registry.v1" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["app_id", "root", "runtime", "framework", "stack_adapter"],
        "properties": {
          "app_id": { "type": "string" },
          "root": { "type": "string" },
          "runtime": { "type": "string" },
          "framework": { "type": "string" },
          "stack_adapter": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "shared_ui": { "type": "array" }
  },
  "additionalProperties": true
}
