{
  "schema": "smc.ges.domain-activation-rules.v1",
  "extensions": [
    ".tsx",
    ".jsx",
    ".vue",
    ".css",
    ".scss",
    ".less",
    ".html"
  ],
  "path_globs": [
    "**/renderer/**",
    "**/components/**",
    "**/screens/**",
    "**/pages/**",
    "**/views/**",
    "**/ui/**"
  ],
  "target_tokens": [
    "renderer_ui",
    "react_component",
    "vue_component",
    "css_theme",
    "interaction"
  ],
  "exclude_globs": [
    "**/generated/**",
    "**/dist/**"
  ]
}
