{
  "schema": "smc.ges.domain-pack.v2",
  "id": "ops",
  "version": "2.2.0",
  "display_name": "ops engineering",
  "activation_rules": "activation.json",
  "policy_lock": "policy-lock.json",
  "capabilities": {
    "preplan": {
      "skill": "smc-ops-preplan"
    },
    "engineering": {
      "skill": "smc-ops-engineering"
    },
    "review": {
      "skill": "smc-ops-review"
    },
    "verification": {
      "skill": "smc-ops-verification"
    }
  },
  "preplan_section": "Ops Design Intent",
  "preplan_validator": ".agents/skills/smc-ops-preplan/scripts/validate_prd_intent.py",
  "plan_extension": {
    "contract": "smc.ops.quality.v2",
    "section": "Ops Quality Ledger",
    "columns": [
      "Change ID",
      "Deployment Impact",
      "Compatibility",
      "Environment/Config",
      "Health",
      "Migration Order",
      "Rollback",
      "Verification"
    ],
    "defaults": {}
  },
  "plan_validator": ".agents/skills/smc-ops-review/scripts/validate_plan_extension.py",
  "selftest": ".agents/skills/smc-ops-preplan/scripts/selftest.py",
  "evidence_namespace": "ops",
  "intent_bindings": {
    "Deployment Impact": {"plan_column": "Deployment Impact", "mode": "EXACT"},
    "Compatibility": {"plan_column": "Compatibility", "mode": "EXACT"},
    "Environment/Config": {"plan_column": "Environment/Config", "mode": "EXACT"},
    "Migration Order": {"plan_column": "Migration Order", "mode": "EXACT"},
    "Rollback": {"plan_column": "Rollback", "mode": "EXACT"},
    "Live Verification": {"plan_column": "Verification", "mode": "EXACT"}
  }
}
