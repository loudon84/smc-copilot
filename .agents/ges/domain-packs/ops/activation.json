{
  "schema": "smc.ges.domain-activation-rules.v1",
  "extensions": [
    ".tf",
    ".tfvars"
  ],
  "path_globs": [
    "Dockerfile",
    "**/Dockerfile",
    "docker-compose*",
    ".github/workflows/**",
    "**/deploy/**",
    "**/k8s/**",
    "**/helm/**",
    "**/migrations/**"
  ],
  "target_tokens": [
    "deployment",
    "rollback",
    "ops",
    "infrastructure"
  ],
  "exclude_globs": [
    "**/generated/**",
    "**/dist/**"
  ]
}
