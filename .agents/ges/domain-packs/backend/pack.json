{
  "schema": "smc.ges.domain-pack.v2",
  "id": "backend",
  "version": "2.2.0",
  "display_name": "backend engineering",
  "activation_rules": "activation.json",
  "policy_lock": "policy-lock.json",
  "capabilities": {
    "preplan": {
      "skill": "smc-backend-preplan"
    },
    "engineering": {
      "skill": "smc-backend-engineering"
    },
    "review": {
      "skill": "smc-backend-review"
    },
    "verification": {
      "skill": "smc-backend-verification"
    }
  },
  "preplan_section": "Backend Design Intent",
  "preplan_validator": ".agents/skills/smc-backend-preplan/scripts/validate_prd_intent.py",
  "plan_extension": {
    "contract": "smc.backend.quality.v2",
    "section": "Backend Quality Ledger",
    "columns": [
      "Change ID",
      "Owner",
      "Contract",
      "Data/Transaction",
      "Auth",
      "Idempotency/Concurrency",
      "Failure Semantics",
      "Observability",
      "Verification"
    ],
    "defaults": {}
  },
  "plan_validator": ".agents/skills/smc-backend-review/scripts/validate_plan_extension.py",
  "selftest": ".agents/skills/smc-backend-preplan/scripts/selftest.py",
  "evidence_namespace": "backend",
  "intent_bindings": {
    "Owner": {"plan_column": "Owner", "mode": "EXACT"},
    "Contract": {"plan_column": "Contract", "mode": "EXACT"},
    "Data/Transaction": {"plan_column": "Data/Transaction", "mode": "EXACT"},
    "Auth": {"plan_column": "Auth", "mode": "EXACT"},
    "Idempotency/Concurrency": {"plan_column": "Idempotency/Concurrency", "mode": "EXACT"}
  }
}
