{
  "schema": "smc.ges.frontend-adapter.v1",
  "id": "nuxt",
  "framework": "vue3",
  "runtime_hints": ["browser", "node", "nuxt", "nitro"],
  "router_hints": ["vue-router", "nuxt-pages", "pages/"],
  "state_hints": ["pinia", "useState"],
  "component_globs": ["components/**/*.vue", "pages/**/*.vue", "layouts/**/*.vue", "app.vue"],
  "test_stack": ["vitest", "@vue/test-utils", "playwright", "cypress"],
  "layout_conventions": ["layouts/default.vue", "NuxtLayout", "Sidebar", "Header"]
}
