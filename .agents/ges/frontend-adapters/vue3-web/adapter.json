{
  "schema": "smc.ges.frontend-adapter.v1",
  "id": "vue3-web",
  "framework": "vue3",
  "runtime_hints": ["browser", "vite", "webpack", "spa"],
  "router_hints": ["vue-router"],
  "state_hints": ["pinia", "vuex"],
  "component_globs": ["src/**/*.vue", "src/**/*.ts", "components/**/*.vue"],
  "test_stack": ["vitest", "jest", "@vue/test-utils", "playwright", "cypress"],
  "layout_conventions": ["AppLayout.vue", "Layout.vue", "Sidebar", "Header", "Footer"]
}
