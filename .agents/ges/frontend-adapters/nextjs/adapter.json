{
  "schema": "smc.ges.frontend-adapter.v1",
  "id": "nextjs",
  "framework": "react",
  "runtime_hints": ["browser", "node", "next", "rsc"],
  "router_hints": ["next/router", "next/navigation", "app-router", "pages-router"],
  "state_hints": ["react-query", "@tanstack/react-query", "zustand", "redux"],
  "component_globs": ["app/**/*.tsx", "pages/**/*.tsx", "components/**/*.tsx", "src/**/*.tsx"],
  "test_stack": ["jest", "vitest", "@testing-library/react", "playwright", "cypress"],
  "layout_conventions": ["layout.tsx", "RootLayout", "Sidebar", "Header"]
}
