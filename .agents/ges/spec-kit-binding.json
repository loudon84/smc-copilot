{
  "schema": "smc.ges.spec-kit-binding.v1",
  "provider": "spec-kit",
  "claim": "ADAPTER_READY",
  "scaffold_root": ".specify",
  "forbidden_sot": [
    ".specify/spec.md"
  ],
  "allowed_scaffold": [
    ".specify/constitution.md",
    ".specify/templates/",
    ".specify/scripts/",
    ".specify/specs/README.md"
  ],
  "canonical_writer": "smc-prd-grounding",
  "ux_import_root": ".smc/runs/<work_item_id>/ux/",
  "probe": "integrations/spec-kit/probe.py",
  "notes": "Bootstrap may create scaffold only; probe/import never write Consumer-root requirements SOT."
}
