[Actions]
requiredWinstVersion >= 4.12.0

DefVar $requestId$
DefVar $clientId$
DefVar $exitCode$

set $requestId$ = GetProductProperty("request_id", "")
set $clientId$ = GetProductProperty("client_id", "")

if ($requestId$ = "")
	isFatalError "missing request_id"
endif
if ($clientId$ = "")
	isFatalError "missing client_id"
endif

DosInTheBackground "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ""%ScriptPath%\scripts\Invoke-SmcHermesAgent.ps1"" -Action uninstall -RequestId ""$requestId$"" -ClientId ""$clientId$"""
set $exitCode$ = getLastExitCode
if not ($exitCode$ = "0")
	isFatalError "uninstall failed"
endif
