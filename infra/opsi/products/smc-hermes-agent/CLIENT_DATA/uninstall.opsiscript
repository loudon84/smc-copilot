[Actions]
requiredWinstVersion >= 4.12.0

DefVar $requestId$
DefVar $exitCode$

set $requestId$ = GetProductProperty("request_id", "")

if not ($requestId$ = "")
	DosInTheBackground "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ""%ScriptPath%\scripts\Invoke-SmcHermesAgent.ps1"" -Action uninstall -RequestId ""$requestId$"""
	set $exitCode$ = getLastExitCode
	if not ($exitCode$ = "0")
		isFatalError "uninstall failed"
	endif
else
	isFatalError "missing request_id"
endif
