[Actions]
requiredWinstVersion >= 4.12.0

DefVar $requestId$
DefVar $hermesVersion$
DefVar $exitCode$

set $requestId$ = GetProductProperty("request_id", "")
set $hermesVersion$ = GetProductProperty("hermes_version", "")

if not ($requestId$ = "")
	comment "SMC setup via signed PowerShell adapter"
	DosInTheBackground "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ""%ScriptPath%\scripts\Invoke-SmcHermesAgent.ps1"" -Action setup -RequestId ""$requestId$"" -HermesVersion ""$hermesVersion$"""
	set $exitCode$ = getLastExitCode
	if not ($exitCode$ = "0")
		LogError "smc-hermes-agent setup failed, exit=" + $exitCode$
		isFatalError "setup failed"
	endif
else
	LogError "request_id is required"
	isFatalError "missing request_id"
endif
