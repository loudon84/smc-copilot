{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/contracts/opsi/endpoint-state.schema.json",
  "title": "smc.hermes.state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "clientId",
    "timestamp",
    "hermes",
    "gateway",
    "config",
    "health"
  ],
  "properties": {
    "schema": { "const": "smc.hermes.state.v1" },
    "owner": { "const": "opsi" },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z._+-]+$" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "reachable"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "reachable": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "status": { "enum": ["CURRENT", "OUTDATED", "APPLYING", "FAILED", "UNKNOWN"] }
      }
    },
    "health": { "enum": ["HEALTHY", "WARNING", "CRITICAL", "OFFLINE", "UNKNOWN"] }
  }
}
