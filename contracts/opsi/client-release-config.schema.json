{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/contracts/opsi/client-release-config.schema.json",
  "title": "smc.client-release.config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "clientRuntime", "work", "hermes", "opsi", "external"],
  "properties": {
    "schema": { "const": "smc.client-release.config.v1" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "channel": { "enum": ["lab", "testing", "stable"] }
      }
    },
    "clientRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "python", "node"],
      "properties": {
        "platform": { "enum": ["windows"] },
        "architecture": { "enum": ["amd64"] },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "range"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 16 },
            "range": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "range"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 16 },
            "range": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "version", "profile"],
      "properties": {
        "repo": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "opsi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productVersion", "packageVersion", "controllerRevision", "buildMode"],
      "properties": {
        "productVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 16 },
        "controllerRevision": { "type": "string", "minLength": 1, "maxLength": 32 },
        "buildMode": { "enum": ["native"] }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opsiClientInstaller"],
      "properties": {
        "opsiClientInstaller": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
