{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/contracts/opsi/diagnostic.schema.json",
  "title": "smc.hermes.diagnostic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "clientId",
    "issueCode",
    "severity",
    "recommendedAction",
    "files",
    "redacted"
  ],
  "properties": {
    "schema": { "const": "smc.hermes.diagnostic.v1" },
    "requestId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 80,
      "pattern": "^req_[A-Za-z0-9_-]{8,64}$"
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "issueCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
    "recommendedAction": { "type": "string", "minLength": 1, "maxLength": 256 },
    "redacted": { "const": true },
    "files": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        }
      }
    }
  }
}
