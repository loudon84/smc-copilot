{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/contracts/opsi/action-request.schema.json",
  "title": "smc.opsi.action-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "operation", "targets"],
  "properties": {
    "schema": { "const": "smc.opsi.action-request.v1" },
    "requestId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 80,
      "pattern": "^req_[A-Za-z0-9_-]{8,64}$"
    },
    "operation": {
      "enum": [
        "setup",
        "update",
        "uninstall",
        "status",
        "collect-log",
        "apply-config",
        "restart-gateway",
        "diagnose",
        "repair",
        "reconcile-controller"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientId"],
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "userBinding": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["sid", "account"],
            "properties": {
              "sid": {
                "type": "string",
                "minLength": 8,
                "maxLength": 184,
                "pattern": "^S-1-[0-9-]+$"
              },
              "account": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "hermesVersion": { "type": ["string", "null"], "maxLength": 64 },
    "configRevision": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "autoRepairLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "note": { "type": ["string", "null"], "maxLength": 256 }
  }
}
