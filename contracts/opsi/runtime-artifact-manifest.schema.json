{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/contracts/opsi/runtime-artifact-manifest.schema.json",
  "title": "smc.opsi.runtime-artifact.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "platform",
    "architecture",
    "entrypoint",
    "sha256",
    "cliSha256",
    "cliVersion",
    "packageRevision",
    "keyId",
    "bytes"
  ],
  "properties": {
    "schema": { "enum": ["smc.opsi.runtime-artifact.v2", "smc.opsi.runtime-artifact.v3"] },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["windows"] },
    "architecture": { "enum": ["amd64"] },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\\\/:*?\"<>|]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "cliSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "cliVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "packageRevision": { "type": "string", "minLength": 1, "maxLength": 32 },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "bytes": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string" },
    "cliVersionCommand": {
      "type": "array",
      "items": { "type": "string" }
    },
    "controllerCompat": { "type": "string", "maxLength": 32 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  }
}
