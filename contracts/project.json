{
  "name": "contracts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "contracts",
  "projectType": "library",
  "tags": ["type:contracts", "scope:shared"],
  "implicitDependencies": ["runtime"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project services/runtime python tools/contract-generate/export_openapi.py",
          "uv run --project services/runtime python tools/contract-generate/export_event_schemas.py"
        ],
        "parallel": false
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project services/runtime python tools/contract-generate/check_contract_drift.py"
      }
    }
  }
}
