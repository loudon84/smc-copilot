{
  "name": "contracts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "contracts",
  "projectType": "library",
  "tags": ["type:contracts", "scope:shared"],
  "implicitDependencies": ["runtime", "salt-control", "opsi-control"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project services/runtime python tools/contract-generate/export_openapi.py",
          "uv run --project services/runtime python tools/contract-generate/export_event_schemas.py",
          "uv run --project services/salt-control python tools/contract-generate/export_salt_control_openapi.py",
          "uv run --project services/opsi-control python tools/contract-generate/export_opsi_control_openapi.py"
        ],
        "parallel": false
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project services/runtime python tools/contract-generate/check_contract_drift.py",
          "uv run --project services/salt-control python tools/contract-generate/check_salt_control_drift.py",
          "uv run --project services/opsi-control python tools/contract-generate/check_opsi_control_drift.py"
        ],
        "parallel": false
      }
    }
  }
}
