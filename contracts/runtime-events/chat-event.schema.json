{
  "$id": "https://smc-copilot.local/contracts/runtime-events/chat-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "profile_id",
        "workspace_id",
        "session_id",
        "content"
      ],
      "title": "WorkspaceChatChunkEvent",
      "type": "object"
    },
    {
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "profile_id",
        "workspace_id",
        "session_id",
        "name"
      ],
      "title": "WorkspaceChatToolProgressEvent",
      "type": "object"
    },
    {
      "properties": {
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "profile_id",
        "workspace_id",
        "session_id"
      ],
      "title": "WorkspaceChatUsageEvent",
      "type": "object"
    },
    {
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "resolved_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Session Id"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "profile_id",
        "workspace_id",
        "session_id"
      ],
      "title": "WorkspaceChatDoneEvent",
      "type": "object"
    },
    {
      "properties": {
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "profile_id",
        "workspace_id",
        "session_id",
        "message"
      ],
      "title": "WorkspaceChatErrorEvent",
      "type": "object"
    }
  ],
  "title": "WorkspaceChatSseEvent"
}
