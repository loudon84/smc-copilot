.DS_Store
.idea/

# Dependencies
node_modules/

# Build output
dist/
out/

# Accidental `tsc -b` / composite emit beside sources.
# Typecheck must use `tsc --noEmit`; runtime build writes to out/dist only.
src/**/*.js
src/**/*.d.ts
!src/main/env.d.ts
!src/main/ws.d.ts
!src/preload/index.d.ts
!src/renderer/src/env.d.ts
!src/renderer/src/screens/Office/office3d/troika-three-text.d.ts
electron.vite.config.js
electron.vite.config.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# ESLint cache
.eslintcache

# Local isolated Hermes homes for development/tests
.sandbox/

# Generated packaged identity (rebuilds on npm run build)
resources/work-build-info.json

.claude/worktrees

# Tauri
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/WixTools/

# Local launcher scripts (user-specific, do not commit)
/*.bat
/*.ps1
.mcp.json
