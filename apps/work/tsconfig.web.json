{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*",
    "src/preload/*.d.ts",
    "components/ui/**/*",
    "components/common/**/*",
    "components/file-preview/**/*",
    "components/knowledge/knowledge-base-card.tsx",
    "components/knowledge/document-detail/**/*",
    "utils/**/*",
    "hooks/**/*"
  ],
  "exclude": [
    "references/**",
    "wiki/**",
    "node_modules",
    "dist",
    "out",
    "components/layout/**",
    "components/knowledge/citation-card.tsx",
    "components/knowledge/document-table.tsx",
    "components/knowledge/document-status-badge.tsx",
    "components/knowledge/knowledge-set-card.tsx",
    "components/knowledge/permission-badge.tsx",
    "components/knowledge/upload-status-badge.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@/components/ui/*": ["./components/ui/*"],
      "@/components/common/*": ["./components/common/*"],
      "@/components/file-preview": ["./components/file-preview/index.ts"],
      "@/components/file-preview/*": ["./components/file-preview/*"],
      "@/components/knowledge/document-detail": [
        "./components/knowledge/document-detail/index.ts"
      ],
      "@/components/knowledge/document-detail/*": [
        "./components/knowledge/document-detail/*"
      ],
      "@/components/knowledge/knowledge-base-card": [
        "./components/knowledge/knowledge-base-card.tsx"
      ],
      "@/utils/*": ["./utils/*"],
      "@/hooks/*": ["./hooks/*"]
    }
  }
}
