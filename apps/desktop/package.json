{
  "name": "smc-ai-copilot",
  "version": "0.1.9",
  "description": "SMC Copilot APP — self-improving AI assistant",
  "main": "./out/main/index.js",
  "author": "fathah",
  "homepage": "https://github.com/loudon84/ai-os-desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "check:workspaces-no-tailwind": "node scripts/check-workspaces-no-tailwind.cjs",
    "check:tray-assets": "node scripts/check-tray-assets.cjs",
    "check:no-reference-imports": "node scripts/check-no-reference-imports.mjs",
    "check:chat-boundaries": "node scripts/chat-migration/verify.mjs",
    "check:no-renderer-runtime-http": "node scripts/check-no-renderer-runtime-http.mjs",
    "check:no-direct-hermes": "node scripts/check-no-direct-hermes.mjs",
    "check:no-hermes-home-access": "node scripts/check-no-hermes-home-access.mjs",
    "check:no-hermes-cli": "node scripts/check-no-hermes-cli.mjs",
    "check:no-legacy-profile-chat": "node scripts/check-no-legacy-profile-chat.mjs",
    "check:no-direct-instance-chat": "node scripts/check-no-direct-instance-chat.mjs",
    "check:no-legacy-local-task-client": "node scripts/check-no-legacy-local-task-client.mjs",
    "check:no-desktop-kanban-hermes-access": "node scripts/check-no-desktop-kanban-hermes-access.mjs",
    "check:no-desktop-hermes-install": "node scripts/check-no-desktop-hermes-install.mjs",
    "check:no-startup-hermes-direct": "node scripts/check-no-startup-hermes-direct.mjs",
    "check:no-desktop-gateway-lifecycle": "node scripts/check-no-desktop-gateway-lifecycle.mjs",
    "check:no-startup-hermes-home": "node scripts/check-no-startup-hermes-home.mjs",
    "check:no-desktop-hermes-port": "node scripts/check-no-desktop-hermes-port.mjs",
    "check:no-desktop-gateway-health": "node scripts/check-no-desktop-gateway-health.mjs",
    "check:no-desktop-port-management": "node scripts/check-no-desktop-port-management.mjs",
    "check:no-desktop-portal-runtime": "node scripts/check-no-desktop-portal-runtime.mjs",
    "check:no-desktop-runtime-process-control": "node scripts/check-no-desktop-runtime-process-control.mjs",
    "check:no-desktop-hermes-control": "node scripts/check-no-desktop-hermes-control.mjs",
    "check:no-desktop-hermes-data": "node scripts/check-no-desktop-hermes-data.mjs",
    "check:no-desktop-domain-db": "node scripts/check-no-desktop-domain-db.mjs",
    "check:no-desktop-expert-mcp-proxy": "node scripts/check-no-desktop-expert-mcp-proxy.mjs",
    "check:no-desktop-mcp-proxy": "node scripts/check-no-desktop-mcp-proxy.mjs",
    "check:no-desktop-agent-listener": "node scripts/check-no-desktop-agent-listener.mjs",
    "check:pairing-boundary": "node scripts/check-pairing-boundary.mjs",
    "check:no-desktop-runtime-spawn": "node scripts/check-no-desktop-runtime-spawn.mjs",
    "check:desktop-chat-runtime-only": "node scripts/check-desktop-chat-runtime-only.mjs",
    "check:runtime-path-ownership": "node ../../tools/agent-context/check-runtime-path-ownership.mjs",
    "prebuild": "node ../../tools/release/generate-build-info.mjs",
    "pretypecheck": "node ../../tools/release/generate-build-info.mjs",
    "guard": "npm run check:workspaces-no-tailwind && npm run check:no-reference-imports && npm run check:no-renderer-runtime-http && npm run check:no-direct-hermes && npm run check:no-hermes-home-access && npm run check:no-hermes-cli && npm run check:no-legacy-profile-chat && npm run check:no-direct-instance-chat && npm run check:no-legacy-local-task-client && npm run check:no-desktop-kanban-hermes-access && npm run check:no-desktop-hermes-install && npm run check:no-startup-hermes-direct && npm run check:no-desktop-gateway-lifecycle && npm run check:no-startup-hermes-home && npm run check:no-desktop-hermes-port && npm run check:no-desktop-gateway-health && npm run check:no-desktop-port-management && npm run check:no-desktop-portal-runtime && npm run check:no-desktop-runtime-process-control && npm run check:no-desktop-hermes-control && npm run check:no-desktop-hermes-data && npm run check:no-desktop-domain-db && npm run check:no-desktop-expert-mcp-proxy && npm run check:no-desktop-mcp-proxy && npm run check:no-desktop-agent-listener && npm run check:pairing-boundary && npm run check:no-desktop-runtime-spawn && npm run check:desktop-chat-runtime-only && npm run check:runtime-path-ownership && npm run check:chat-boundaries && npm run typecheck:chat",
    "typecheck:chat": "tsc --noEmit -p tsconfig.chat.json --composite false",
    "chat:inventory": "node scripts/chat-migration/inventory.mjs",
    "chat:copy": "node scripts/chat-migration/copy.mjs",
    "chat:rewrite-imports": "node scripts/chat-migration/rewrite-imports.mjs",
    "test": "vitest run",
    "test:e2e:electron": "playwright test -c playwright.electron.config.ts",
    "test:e2e:chat": "playwright test -c playwright.electron.config.ts tests/e2e/chat",
    "test:e2e:electron:required": "node scripts/test-e2e-electron-required.mjs",
    "test:e2e:update": "playwright test -c playwright.electron.config.ts --update-snapshots",
    "ci": "npm run guard && npm run typecheck && npm test && npm run build && npm run test:e2e:electron:required",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev.cjs",
    "dev:fresh": "HERMES_HOME=$(mktemp -d -t hermes-fresh) electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "rebuild:native": "node scripts/rebuild-native-deps.cjs",
    "postinstall": "node scripts/rebuild-native-deps.cjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run check:tray-assets && npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:rpm": "npm run build && electron-builder --linux rpm",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "i18next": "^25.6.0",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "lucide-react": "^1.7.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/highlight.js": "^9.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.4"
  }
}
