<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Burn bootstrapper (PRD v1.5 FR-04).
  Chains SMC-Copilot-Runtime MSI; forwards quiet install variables.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle
    Name="SMC Copilot Runtime Setup"
    Version="1.5.0.0"
    Manufacturer="SMC"
    UpgradeCode="C3D4E5F6-A7B8-9012-CDEF-123456789012">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkLicense" />
    </BootstrapperApplication>

    <Variable Name="Channel" Type="string" Value="stable" bal:Overridable="yes" />
    <Variable Name="InstallScope" Type="string" Value="user" bal:Overridable="yes" />
    <Variable Name="BootstrapConfig" Type="string" Value="" bal:Overridable="yes" />

    <Chain>
      <MsiPackage
        Id="CopilotRuntimeMsi"
        SourceFile="!(bindpath.build)\SMC-Copilot-Runtime-1.5.0-x64.msi"
        Vital="yes"
        Compressed="yes"
        DisplayInternalUI="no">
        <MsiProperty Name="CHANNEL" Value="[Channel]" />
        <MsiProperty Name="BOOTSTRAPCONFIG" Value="[BootstrapConfig]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
