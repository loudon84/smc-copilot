<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Toolset 5 package for SMC Copilot Runtime (PRD v1.5 FR-04).
  Default install scope: per-user under %LOCALAPPDATA%\Programs\SMC\CopilotRuntime.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="SMC Copilot Runtime"
    Manufacturer="SMC"
    Version="1.5.0.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perUser"
    InstallerVersion="500"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of SMC Copilot Runtime is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="CHANNEL" Value="stable" />
    <Property Id="BOOTSTRAPCONFIG" Value="" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="SMCProgramsFolder" Name="Programs">
        <Directory Id="SMCVendorFolder" Name="SMC">
          <Directory Id="INSTALLFOLDER" Name="CopilotRuntime" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="SMC Copilot Runtime" Level="1">
      <ComponentGroupRef Id="CopilotRuntimeComponents" />
    </Feature>

    <CustomAction
      Id="RegisterUserDaemon"
      Directory="INSTALLFOLDER"
      ExeCommand="[INSTALLFOLDER]python\python.exe -m local_service.windows_user_daemon install --replace"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RegisterUserDaemon" After="InstallFiles" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="CopilotRuntimeComponents" Directory="INSTALLFOLDER">
      <Component Id="CopilotRuntimePayload" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="CopilotRuntime.exe" Source="!(bindpath.build)\CopilotRuntime.exe" KeyPath="yes" />
      </Component>
      <Component Id="RuntimeLauncherCmd" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
        <File Id="RuntimeLauncherCmd" Source="!(bindpath.build)\bundle\runtime-launcher.cmd" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
