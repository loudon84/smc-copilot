# Lab OPSI Control → opsiconfd (do not commit real secrets)
# Copy to .env and fill credentials. SMC_OPSI_ENV=lab uses HttpOpsiJsonRpc + PostgreSQL.
# Fake RPC / Memory repositories exist only when SMC_OPSI_ENV=test.
# Do not point database_url at the OPSI Server database. Use an isolated
# company PostgreSQL database/schema and a least-privilege role.

SMC_OPSI_ENV=lab
opsi_rpc_url=https://192.168.102.104:4447/rpc
opsi_rpc_username=
opsi_rpc_password=
opsi_rpc_password_ref=
opsi_rpc_ca_bundle=
database_url=postgresql+asyncpg://opsi_control_lab:CHANGE_ME@db.internal:5432/opsi_control_lab
jwt_lab_secret=lab-only-change-me
start_workers=true
pilot_start_enabled=false
