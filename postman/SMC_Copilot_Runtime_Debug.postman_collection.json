                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const j=pm.response.json(); console.log(JSON.stringify(j,null,2));",
                  "pm.test(\"desired running\",()=>pm.expect(j.desired.state).to.eql(\"running\"));",
                  "pm.test(\"process alive\",()=>pm.expect(j.observed.processState).to.eql(\"alive\"));",
